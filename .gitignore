node_modules/
dist/
build/
*.log
*.tsbuildinfo

# Server data (local SQLite db + uploaded files, never versioned)
server/data/*.db
server/data/*.db-journal
server/uploads/**
!server/uploads/.gitkeep

# Env (todas las variantes salvo el ejemplo)
.env
.env.*
!.env.example
!server/.env.example

# Editor
.vscode/
.idea/

# Capacitor: assets web copiados dentro del proyecto Android; se regeneran
# con "npm run build && npx cap sync android", no se versionan.
client/android/app/src/main/assets/public/

# Carpeta de trabajo del revisor de diseño (capturas y medidas, no es código)
.taste-skill/

# Los APK generados no van al repositorio: son resultado de compilar
*.apk

# Las notas de version en PDF se generan cuando hacen falta; no son codigo
SIGRAM-APP-notas-*.pdf
