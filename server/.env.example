SIGRAM_SERVER_PORT=4000
DB_PATH=./data/sigram.db
UPLOADS_DIR=./uploads

# Solo en producción (Render): base de datos libSQL alojada en Turso, para
# que sobreviva a los reinicios/despliegues del hosting. Si no se rellenan,
# se usa el fichero SQLite local de arriba (DB_PATH).
# TURSO_DATABASE_URL=libsql://tu-base-de-datos.turso.io
# TURSO_AUTH_TOKEN=

# Carpeta del Drive del usuario donde se guardan las fotos. Si no se define,
# se usa "SIGRAM VISITAS". El entorno de pruebas la cambia para no mezclar
# fotos de prueba con las reales (ver docs/ENTORNOS.md).
# DRIVE_FOLDER_NAME=SIGRAM VISITAS (pruebas)
